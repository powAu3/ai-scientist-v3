  "mechanism_formulas": [
    {
      "id": "review_gate",
      "name": "Review gate",
      "formula": "G_review = I[S_sound >= tau_s and S_leak >= tau_l and B <= B_max]",
      "links": [
        "protocol_gate",
        "strict_review"
      ],
      "note": "Blocks paper flow when the proposal needs protocol repair."
    },
    {
      "id": "fusion",
      "name": "Crack-aware fusion",
      "formula": "F_c = P3 + sum_s alpha_s * W_s(P_s), alpha_s = sigmoid(g_s(E_s))",
      "links": [
        "scale_align",
        "elongation_attention",
        "crack_fusion"
      ],
      "note": "Connects multi-scale features to elongated crack structure."
    },
    {
      "id": "thin_loss",
      "name": "Thin-structure loss",
      "formula": "L_thin = L_det + lambda_b L_boundary + lambda_c L_continuity",
      "links": [
        "thin_head",
        "loss_link"
      ],
      "note": "Constrains narrow crack boundaries and continuity."
    },
    {
      "id": "forecast",
      "name": "Forecast calibration",
      "formula": "m_hat = m_lit + Delta_module - rho_risk, U = [m_hat - sigma, m_hat + sigma]",
      "links": [
        "forecast",
        "predicted_results.csv"
      ],
      "note": "Keeps comparison panels conservative until measured replacement."
    },
    {
      "id": "stop_go",
      "name": "Future stop/go rule",
      "formula": "Go = I[Delta_mAP50-95 > 0.015 and FP_image < tau_fp and FPS >= tau_fps]",
      "links": [
        "protocol_gate",
        "future_run"
      ],
      "note": "Defines the decision boundary for the normal experiment branch."
    }
  ],
